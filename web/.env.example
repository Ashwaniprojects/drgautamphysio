# Create a Supabase project (supabase.com), run supabase/schema.sql in its SQL editor,
# then copy these from Project Settings → API into a real .env.local (which is gitignored).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Reserved for the future admin/reception dashboard (server-side only — never expose to
# the browser). Not used by the public booking form, which relies on the RLS insert
# policies in supabase/schema.sql instead.
SUPABASE_SERVICE_ROLE_KEY=
